# Get a key at https://data.jambase.com/
JAMBASE_API_KEY=your_key_here
# Optional overrides
# JAMBASE_BASE_URL=https://api.data.jambase.com/v3
# CACHE_TTL_SECONDS=300

# Reservations. Both Stripe values are required to enable Checkout.
# The process refuses to start if STRIPE_SECRET_KEY is set and does not start with sk_test_.
# Test mode: no real charges.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BASE_URL=http://127.0.0.1:8000
# DATABASE_URL=sqlite+aiosqlite:///./local-events.db
# RESERVATION_CAP_PER_EVENT=10
